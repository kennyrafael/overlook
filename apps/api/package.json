{
  "name": "@overlook/api",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -k -n tsc,api -c gray,blue \"tsc -w -p tsconfig.json --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --import tsx --test src/plans/plan-parser.spec.ts src/plans/plan-writer.spec.ts src/insights/session-log.spec.ts src/insights/live-activity.spec.ts src/discovery/claude-roots.spec.ts src/insights/log-fixtures.spec.ts src/database/migrations.spec.ts src/actions/mac-terminal.spec.ts src/actions/linux-terminal.spec.ts src/actions/claude-launch.spec.ts src/insights/prompt-index.spec.ts",
    "predev": "tsc -p tsconfig.json",
    "test:e2e": "tsc -p tsconfig.json && node --import tsx --test --test-force-exit --test-concurrency=1 test/e2e.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@overlook/shared": "0.3.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2"
  }
}
