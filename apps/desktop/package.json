{
  "name": "@overlook/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Overlook desktop app (Electron shell around the local server and UI)",
  "author": "AgentHub",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "stage": "node scripts/stage.mjs",
    "dist": "npm run build && node scripts/build.mjs"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
